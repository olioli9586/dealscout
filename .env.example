# Required: Anthropic API key used by the research agent.
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown).
# DEALSCOUT_MODEL=claude-opus-4-8
# DEALSCOUT_EFFORT=medium
# DEMO_DAILY_LIMIT=10

# v2 (the agent in agent/ reads this file too: uv run --env-file ../.env.local).
# The full list is in README.md.
# AGENT_URL=http://127.0.0.1:8001
# AGENT_MODELS=anthropic
# V2_ADMIN_TOKEN=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
